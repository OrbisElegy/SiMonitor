<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Monitor.Infrastructure/Monitor.Infrastructure.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <NativeAudioBinary Condition="Exists('../../artifacts/native-audio/Release/sim_audio_native.dll')">../../artifacts/native-audio/Release/sim_audio_native.dll</NativeAudioBinary>
    <NativeAudioBinary Condition="'$(NativeAudioBinary)' == '' And Exists('../../artifacts/native-audio/sim_audio_native.dll')">../../artifacts/native-audio/sim_audio_native.dll</NativeAudioBinary>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeAudioBinary)' != ''">
    <None Include="$(NativeAudioBinary)" Link="sim_audio_native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../native/sim_audio_native/vendor/LICENSE.miniaudio" Link="LICENSE.miniaudio" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- Exclude optional build telemetry targets from this development shell. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="help-topics.json" LogicalName="Monitor.Help.Topics" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Monitor.Legal.LICENSE" />
    <EmbeddedResource Include="../../eng/dependencies.json" LogicalName="Monitor.Legal.dependencies.json" />
    <EmbeddedResource Include="../../eng/licenses/*" LogicalName="Monitor.Legal.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../native/sim_audio_native/vendor/LICENSE.miniaudio" LogicalName="Monitor.Legal.LICENSE.miniaudio" />
    <EmbeddedResource Include="../../docs/license-scope.md" LogicalName="Monitor.Legal.license-scope.md" />
  </ItemGroup>
  <Target Name="GenerateStylePreviews" AfterTargets="Build"
          Inputs="$(TargetPath);@(ReferenceCopyLocalPaths)"
          Outputs="$(TargetDir)style-previews.bin"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --generate-style-previews &quot;$(TargetDir)style-previews.bin&quot;" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)style-previews.bin" />
    </ItemGroup>
  </Target>
  <Target Name="PublishStylePreviews" AfterTargets="ComputeFilesToPublish" DependsOnTargets="GenerateStylePreviews">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)style-previews.bin">
        <RelativePath>style-previews.bin</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
