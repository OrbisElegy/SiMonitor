{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.monitor-sim.local/domain/v1/assessment.schema.json",
  "title": "Domain.Contracts assessment and exam integrity",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "AssessmentIntegrity": {"enum": ["VerifiedOnline", "DegradedOffline", "Rejected", "PendingVerification"]},
    "ExamRosterRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "exam_id", "roster_revision", "state", "candidates", "created_at_utc", "created_by_principal_id", "content_sha256"],
      "properties": {
        "schema_id": {"const": "ExamRosterRevision@1"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "roster_revision": {"$ref": "common.schema.json#/$defs/U64"},
        "state": {"enum": ["Draft", "Frozen", "Superseded"]},
        "candidates": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["candidate_id", "display_name", "student_number", "exam_number", "login_method", "account_state", "password_verifier_ref"],
            "properties": {
              "candidate_id": {"$ref": "common.schema.json#/$defs/StableId"},
              "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
              "student_number": {"type": "string", "minLength": 1, "maxLength": 64},
              "exam_number": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]},
              "login_method": {"enum": ["CandidatePassword", "InstitutionFederated", "ProctoredCode"]},
              "account_state": {"enum": ["Pending", "Active", "Locked", "Disabled"]},
              "password_verifier_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/StableId"}, {"type": "null"}]}
            }
          }
        },
        "created_at_utc": {"$ref": "common.schema.json#/$defs/UtcInstant"},
        "created_by_principal_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "content_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    },
    "AssessmentQuestionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "question_ref", "question_kind", "stem_resource_refs", "answer_schema_ref", "answer_schema_sha256", "time_limit_ns", "allowed_system_view_command_ids", "sequence_no", "contains_answer_key", "contains_rubric", "contains_next_question"],
      "properties": {
        "schema_id": {"const": "AssessmentQuestionManifest@1"},
        "question_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "question_kind": {"enum": ["ECGInterpretationStatic", "RealtimeMonitor", "DefibrillatorScenario", "PacerScenario"]},
        "stem_resource_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "answer_schema_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "answer_schema_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "time_limit_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "allowed_system_view_command_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"enum": ["Back", "Theme", "Zoom", "Pagination", "QuickMeasurement"]}},
        "sequence_no": {"type": "integer", "minimum": 1, "maximum": 100000},
        "contains_answer_key": {"const": false},
        "contains_rubric": {"const": false},
        "contains_next_question": {"const": false}
      }
    },
    "AssessmentRubricProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "rubric_ref", "course_refs", "case_refs", "time_basis", "items", "maximum_score", "manual_review_policy", "approval_state", "approved_by_subject_ref", "approval_signature"],
      "properties": {
        "schema_id": {"const": "AssessmentRubricProfile@1"},
        "rubric_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "course_refs": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "case_refs": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "time_basis": {"enum": ["SimulationTime", "AuthoritySafetyClock", "CommitOrder"]},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["item_id", "evidence_type_ids", "action_ids", "sequence_policy", "minimum_duration_ns", "time_window_ns", "full_credit", "partial_credit_policy", "penalty_policy", "repeat_policy", "late_policy", "cancelled_policy", "failed_policy"],
            "properties": {
              "item_id": {"$ref": "common.schema.json#/$defs/StableId"},
              "evidence_type_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
              "action_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "actions.schema.json#/$defs/ActionId"}},
              "sequence_policy": {"enum": ["AnyOrder", "DeclaredOrder", "Contiguous"]},
              "minimum_duration_ns": {"$ref": "common.schema.json#/$defs/U64"},
              "time_window_ns": {"$ref": "common.schema.json#/$defs/U64"},
              "full_credit": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
              "partial_credit_policy": {"enum": ["None", "Proportional", "ExplicitTiers"]},
              "penalty_policy": {"enum": ["None", "Subtract", "CapScore", "FailItem"]},
              "repeat_policy": {"enum": ["FirstOnly", "Best", "Last", "PenalizeRepeat"]},
              "late_policy": {"enum": ["Accept", "Partial", "Reject"]},
              "cancelled_policy": {"enum": ["Ignore", "EvidenceOfAttempt", "Penalty"]},
              "failed_policy": {"enum": ["Ignore", "EvidenceOfAttempt", "Penalty"]}
            }
          }
        },
        "maximum_score": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
        "manual_review_policy": {"enum": ["Never", "OnAmbiguity", "Always", "OnIntegrityDegradation"]},
        "approval_state": {"enum": ["Draft", "Approved", "Retired"]},
        "approved_by_subject_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/StableId"}, {"type": "null"}]},
        "approval_signature": {"oneOf": [{"$ref": "common.schema.json#/$defs/SignatureBlock"}, {"type": "null"}]}
      }
    },
    "AssessmentEvidenceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "evidence_id", "exam_id", "candidate_subject_ref", "instance_id",
        "source_event_id", "source_commit_seq", "evidence_type", "integrity",
        "state_revision", "authority_monotonic_ns", "evidence_sha256"
      ],
      "properties": {
        "schema_id": {"const": "AssessmentEvidenceEvent@1"},
        "evidence_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "instance_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_event_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_commit_seq": {"$ref": "common.schema.json#/$defs/U64"},
        "evidence_type": {"$ref": "common.schema.json#/$defs/StableId"},
        "integrity": {"$ref": "#/$defs/AssessmentIntegrity"},
        "state_revision": {"$ref": "common.schema.json#/$defs/U64"},
        "authority_monotonic_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "evidence_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    },
    "QuestionCompletionPermit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "permit_id", "exam_id", "candidate_subject_ref", "instance_id",
        "question_id", "question_revision", "answer_schema_sha256", "attempt_no",
        "started_at_authority_monotonic_ns", "deadline_authority_monotonic_ns", "signature"
      ],
      "properties": {
        "schema_id": {"const": "QuestionCompletionPermit@1"},
        "permit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "instance_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "question_id": {"$ref": "common.schema.json#/$defs/StableId"},
        "question_revision": {"$ref": "common.schema.json#/$defs/U64"},
        "answer_schema_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "attempt_no": {"type": "integer", "minimum": 1, "maximum": 100},
        "started_at_authority_monotonic_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "deadline_authority_monotonic_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "signature": {"$ref": "common.schema.json#/$defs/SignatureBlock"}
      }
    },
    "ExamRunLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "lease_id", "exam_id", "candidate_subject_ref", "instance_id",
        "leader_epoch", "fencing_token", "last_common_commit_seq", "run_until_sim_time_ns",
        "issued_at_safety_ns", "expires_at_safety_ns", "signature"
      ],
      "properties": {
        "schema_id": {"const": "ExamRunLease@1"},
        "lease_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "instance_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "leader_epoch": {"$ref": "common.schema.json#/$defs/U64"},
        "fencing_token": {"$ref": "common.schema.json#/$defs/U64"},
        "last_common_commit_seq": {"$ref": "common.schema.json#/$defs/U64"},
        "run_until_sim_time_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "issued_at_safety_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "expires_at_safety_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "signature": {"$ref": "common.schema.json#/$defs/SignatureBlock"}
      }
    },
    "OfflineAnswerEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "answer_id", "permit_id", "exam_id", "candidate_subject_ref",
        "question_id", "question_revision", "attempt_no", "sealed_at_client_monotonic_ns",
        "answer_schema_sha256", "answer_payload_sha256", "answer_payload_base64",
        "integrity", "client_signature"
      ],
      "properties": {
        "schema_id": {"const": "OfflineAnswerEnvelope@1"},
        "answer_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "permit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "question_id": {"$ref": "common.schema.json#/$defs/StableId"},
        "question_revision": {"$ref": "common.schema.json#/$defs/U64"},
        "attempt_no": {"type": "integer", "minimum": 1, "maximum": 100},
        "sealed_at_client_monotonic_ns": {"$ref": "common.schema.json#/$defs/I64"},
        "answer_schema_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "answer_payload_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "answer_payload_base64": {"$ref": "common.schema.json#/$defs/Base64"},
        "integrity": {"const": "DegradedOffline"},
        "client_signature": {"$ref": "common.schema.json#/$defs/SignatureBlock"}
      }
    },
    "AssessmentScoreRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "score_revision_id", "exam_id", "candidate_subject_ref",
        "rubric_ref", "case_ref", "evidence_frontier_commit_seq", "score_mantissa_i64",
        "score_exponent10", "max_score_mantissa_i64", "result_sha256"
      ],
      "properties": {
        "schema_id": {"const": "AssessmentScoreRevision@1"},
        "score_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "rubric_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "case_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "evidence_frontier_commit_seq": {"$ref": "common.schema.json#/$defs/U64"},
        "score_mantissa_i64": {"$ref": "common.schema.json#/$defs/I64"},
        "score_exponent10": {"type": "integer", "minimum": -6, "maximum": 6},
        "max_score_mantissa_i64": {"$ref": "common.schema.json#/$defs/I64"},
        "result_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    },
    "AssessmentFinalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "finalization_id", "idempotency_key", "exam_id", "candidate_subject_ref",
        "rubric_ref", "case_ref", "evidence_frontier_commit_seq", "score_revision_id",
        "finalized_at_utc", "result_sha256"
      ],
      "properties": {
        "schema_id": {"const": "AssessmentFinalization@1"},
        "finalization_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "idempotency_key": {"$ref": "common.schema.json#/$defs/StableId"},
        "exam_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "candidate_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "rubric_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "case_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "evidence_frontier_commit_seq": {"$ref": "common.schema.json#/$defs/U64"},
        "score_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "finalized_at_utc": {"$ref": "common.schema.json#/$defs/UtcInstant"},
        "result_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    }
  }
}
