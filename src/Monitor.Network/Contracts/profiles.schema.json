{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.monitor-sim.local/domain/v1/profiles.schema.json",
  "title": "Domain.Contracts device, alarm, pacer and network profiles",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "DeviceCapabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "profile_ref", "measurement_capability_ids", "monitor_input_source_ids",
        "display_lead_ids", "hr_estimator_ids", "sync_qrs_source_ids", "pacer_sensing_source_ids",
        "operating_modes", "therapy_pulse_profile_refs", "energy_levels", "sync_supported",
        "pacer_rate_range", "pacer_output_range", "required_capability_ids", "optional_capability_ids"
      ],
      "properties": {
        "schema_id": {"const": "DeviceCapabilityManifest@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "measurement_capability_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "monitor_input_source_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "display_lead_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "hr_estimator_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "sync_qrs_source_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "pacer_sensing_source_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "operating_modes": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["MonitorECG", "ManualDefib", "AED", "TranscutaneousPacing"]}},
        "therapy_pulse_profile_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "energy_levels": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/DecimalQuantity"}},
        "sync_supported": {"type": "boolean"},
        "pacer_rate_range": {"oneOf": [{"$ref": "#/$defs/QuantityRange"}, {"type": "null"}]},
        "pacer_output_range": {"oneOf": [{"$ref": "#/$defs/QuantityRange"}, {"type": "null"}]},
        "required_capability_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "optional_capability_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}}
      }
    },
    "QuantityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "step"],
      "properties": {
        "minimum": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
        "maximum": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
        "step": {"$ref": "common.schema.json#/$defs/DecimalQuantity"}
      }
    },
    "InstitutionBrandPackManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "pack_ref", "institution_id", "publisher", "approver_subject_ref",
        "valid_from_utc", "valid_until_utc", "assets", "target_app_version_range",
        "signature", "contains_executable_content"
      ],
      "properties": {
        "schema_id": {"const": "InstitutionBrandPackManifest@1"},
        "pack_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "institution_id": {"$ref": "common.schema.json#/$defs/StableId"},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 256},
        "approver_subject_ref": {"$ref": "common.schema.json#/$defs/StableId"},
        "valid_from_utc": {"$ref": "common.schema.json#/$defs/UtcInstant"},
        "valid_until_utc": {"$ref": "common.schema.json#/$defs/UtcInstant"},
        "assets": {
          "type": "array", "minItems": 1, "maxItems": 512,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["asset_id", "asset_kind", "path", "sha256", "source", "author", "license_id", "authorization_evidence_ref", "semantic_slot_ids"],
            "properties": {
              "asset_id": {"$ref": "common.schema.json#/$defs/StableId"},
              "asset_kind": {"enum": ["Font", "Icon", "Logo"]},
              "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).{1,256}$", "maxLength": 256},
              "sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
              "source": {"type": "string", "minLength": 1, "maxLength": 512},
              "author": {"type": "string", "minLength": 1, "maxLength": 256},
              "license_id": {"$ref": "common.schema.json#/$defs/StableId"},
              "authorization_evidence_ref": {"$ref": "common.schema.json#/$defs/StableId"},
              "semantic_slot_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}}
            }
          }
        },
        "target_app_version_range": {"type": "string", "minLength": 1, "maxLength": 64},
        "signature": {"$ref": "common.schema.json#/$defs/SignatureBlock"},
        "contains_executable_content": {"const": false}
      }
    },
    "AlarmRuleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "profile_ref", "rule_id", "patient_applicability_ids", "device_applicability_ids",
        "course_applicability_ids", "source_measurement_channel_ref", "technical_source_id",
        "threshold", "direction", "hysteresis", "on_delay_ns", "off_delay_ns", "priority",
        "minimum_priority", "escalation_policy_ref", "latch_policy", "ack_policy", "enabled",
        "pause_breakthrough_policy", "invalid_policy", "stale_policy", "no_data_policy",
        "source_switch_policy", "recovery_episode_policy", "repetition_policy_ref", "audit_required"
      ],
      "properties": {
        "schema_id": {"const": "AlarmRuleProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "rule_id": {"$ref": "common.schema.json#/$defs/StableId"},
        "patient_applicability_ids": {"type": "array", "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "device_applicability_ids": {"type": "array", "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "course_applicability_ids": {"type": "array", "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "source_measurement_channel_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/MeasurementChannelRef"}, {"type": "null"}]},
        "technical_source_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/StableId"}, {"type": "null"}]},
        "threshold": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
        "direction": {"enum": ["Above", "Below"]},
        "hysteresis": {"$ref": "common.schema.json#/$defs/DecimalQuantity"},
        "on_delay_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "off_delay_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "priority": {"enum": ["High", "Medium", "Low", "Advisory"]},
        "minimum_priority": {"enum": ["High", "Medium", "Low", "Advisory"]},
        "escalation_policy_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/VersionedRef"}, {"type": "null"}]},
        "latch_policy": {"enum": ["NonLatching", "LatchUntilAck", "LatchUntilConditionClearAndAck"]},
        "ack_policy": {"enum": ["AcknowledgementAllowed", "AcknowledgementForbidden"]},
        "enabled": {"type": "boolean"},
        "pause_breakthrough_policy": {"enum": ["Never", "HigherPriority", "AnyNewEpisode"]},
        "invalid_policy": {"enum": ["SuspendUnknown", "TechnicalAlarm", "ClearAndReevaluate"]},
        "stale_policy": {"enum": ["SuspendUnknown", "TechnicalAlarm", "ContinueLastValue"]},
        "no_data_policy": {"enum": ["SuspendUnknown", "TechnicalAlarm"]},
        "source_switch_policy": {"enum": ["PreserveBinding", "RebindAndNewEpisode", "DisableUntilResolved"]},
        "recovery_episode_policy": {"enum": ["PreserveEpisode", "CreateNewEpisode"]},
        "repetition_policy_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "audit_required": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["source_measurement_channel_ref"], "properties": {"source_measurement_channel_ref": {"$ref": "common.schema.json#/$defs/MeasurementChannelRef"}, "technical_source_id": {"type": "null"}}},
        {"required": ["technical_source_id"], "properties": {"source_measurement_channel_ref": {"type": "null"}, "technical_source_id": {"$ref": "common.schema.json#/$defs/StableId"}}}
      ]
    },
    "PacerTimingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "escape_anchor_policy", "same_time_policy", "running_parameter_change_policy", "pause_resume_policy", "recovery_policy"],
      "properties": {
        "schema_id": {"const": "PacerTimingProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "escape_anchor_policy": {"const": "LaterOfQualifiedIntrinsicQRSOrIssuedStimulus"},
        "same_time_policy": {"enum": ["SenseWins", "StimulusWins"]},
        "running_parameter_change_policy": {"enum": ["ApplyImmediatelyReanchor", "ApplyNextCandidatePreservePhase", "RejectWhileRunning"]},
        "pause_resume_policy": {"const": "NoCatchUpNewAuthorityAnchor"},
        "recovery_policy": {"const": "PausedByRecovery"}
      }
    },
    "PacerSensingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "source_ids", "blanking_ns", "refractory_ns", "self_stimulus_sensing", "invalid_source_policy"],
      "properties": {
        "schema_id": {"const": "PacerSensingProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "blanking_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "refractory_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "self_stimulus_sensing": {"const": "ForbiddenByDefault"},
        "invalid_source_policy": {"const": "FaultStopStimuli"}
      }
    },
    "CaptureRuleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "electrical_capture_rule_ref", "mechanical_capture_rule_ref", "latency_profile_ref", "evidence_requirements"],
      "properties": {
        "schema_id": {"const": "CaptureRuleProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "electrical_capture_rule_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "mechanical_capture_rule_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "latency_profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "evidence_requirements": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}}
      }
    },
    "RealtimeNetworkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "heartbeat_interval_ns", "suspect_after_ns", "disconnected_after_ns", "required_plane_stall_ns", "playout_delay_min_ns", "playout_delay_max_ns", "target_buffer_fill_ns", "sample_buffer_capacity_ns", "reconnect_backoff_profile_ref", "local_continuation_policy_by_mode"],
      "properties": {
        "schema_id": {"const": "RealtimeNetworkProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "heartbeat_interval_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "suspect_after_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "disconnected_after_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "required_plane_stall_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "playout_delay_min_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "playout_delay_max_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "target_buffer_fill_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "sample_buffer_capacity_ns": {"const": "10000000000"},
        "reconnect_backoff_profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "local_continuation_policy_by_mode": {
          "type": "object", "additionalProperties": false,
          "required": ["Teaching", "IndependentAssessment", "Standalone"],
          "properties": {
            "Teaching": {"enum": ["Disabled", "ReadOnly", "CourseApprovedActions"]},
            "IndependentAssessment": {"const": "Disabled"},
            "Standalone": {"enum": ["Disabled", "ReadOnly", "CourseApprovedActions"]}
          }
        }
      }
    },
    "DeviceBehaviorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "capability_profile_ref", "alarm_rule_profile_refs", "aed_algorithm_profile_ref", "pacer_timing_profile_ref", "pacer_sensing_profile_ref", "capture_rule_profile_ref", "therapy_pulse_profile_refs", "post_shock_sync_policy", "recovery_policy"],
      "properties": {
        "schema_id": {"const": "DeviceBehaviorProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "capability_profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "alarm_rule_profile_refs": {"type": "array", "maxItems": 512, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "aed_algorithm_profile_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/VersionedRef"}, {"type": "null"}]},
        "pacer_timing_profile_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/VersionedRef"}, {"type": "null"}]},
        "pacer_sensing_profile_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/VersionedRef"}, {"type": "null"}]},
        "capture_rule_profile_ref": {"oneOf": [{"$ref": "common.schema.json#/$defs/VersionedRef"}, {"type": "null"}]},
        "therapy_pulse_profile_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "post_shock_sync_policy": {"const": "RetainAndReacquire"},
        "recovery_policy": {"enum": ["DisarmAndPauseTherapy", "StopAllTherapy"]}
      }
    },
    "DeviceSignalAcquisitionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "channels", "waveform_block_duration_ns"],
      "properties": {
        "schema_id": {"const": "DeviceSignalAcquisitionProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "channels": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["channel_id", "sample_rate_numerator", "sample_rate_denominator", "sample_format", "scale_numerator", "scale_denominator", "offset_numerator", "offset_denominator", "unit_code"],
            "properties": {
              "channel_id": {"$ref": "common.schema.json#/$defs/StableId"},
              "sample_rate_numerator": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "sample_rate_denominator": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "sample_format": {"const": "INT16_LE"},
              "scale_numerator": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
              "scale_denominator": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "offset_numerator": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
              "offset_denominator": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "unit_code": {"enum": ["MILLIVOLT", "MICROVOLT", "MMHG", "UNITLESS"]}
            }
          }
        },
        "waveform_block_duration_ns": {"const": "200000000"}
      }
    },
    "AEDAlgorithmProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "input_channel_ids", "filter_profile_ref", "required_continuous_window_ns", "motion_policy", "cpr_policy", "quality_failure_result", "determinism_profile_ref"],
      "properties": {
        "schema_id": {"const": "AEDAlgorithmProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "input_channel_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "filter_profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "required_continuous_window_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "motion_policy": {"enum": ["PauseWindow", "ResetWindow", "Restart", "FailIndeterminate"]},
        "cpr_policy": {"enum": ["PauseWindow", "ResetWindow", "Restart", "FailIndeterminate"]},
        "quality_failure_result": {"enum": ["Indeterminate", "AnalysisFailed", "Interrupted"]},
        "determinism_profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"}
      }
    },
    "TherapyPulseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "pulse_kind", "energy_or_output_levels", "pulse_width_ns", "load_model_ref", "delivery_tolerance_ppm"],
      "properties": {
        "schema_id": {"const": "TherapyPulseProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "pulse_kind": {"enum": ["MonophasicDefibrillation", "BiphasicDefibrillation", "TranscutaneousPacing"]},
        "energy_or_output_levels": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/DecimalQuantity"}},
        "pulse_width_ns": {"$ref": "common.schema.json#/$defs/U64"},
        "load_model_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "delivery_tolerance_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "PatientProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "population", "supported_measurement_ids", "sensor_profile_refs", "alarm_limit_profile_refs", "clinical_scope_note_key"],
      "properties": {
        "schema_id": {"const": "PatientProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "population": {"enum": ["Adult", "Pediatric", "Neonatal"]},
        "supported_measurement_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/StableId"}},
        "sensor_profile_refs": {"type": "array", "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "alarm_limit_profile_refs": {"type": "array", "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "clinical_scope_note_key": {"$ref": "common.schema.json#/$defs/LocalizationKey"}
      }
    },
    "CourseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "profile_ref", "mode", "patient_profile_refs", "device_behavior_profile_refs", "presentation_policy_ref", "allowed_offline_action_ids", "assessment_rubric_refs", "approval_state"],
      "properties": {
        "schema_id": {"const": "CourseProfile@1"},
        "profile_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "mode": {"enum": ["Teaching", "PracticeOnly", "IndependentAssessment"]},
        "patient_profile_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "device_behavior_profile_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "presentation_policy_ref": {"$ref": "common.schema.json#/$defs/VersionedRef"},
        "allowed_offline_action_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "actions.schema.json#/$defs/ActionId"}},
        "assessment_rubric_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/VersionedRef"}},
        "approval_state": {"enum": ["Draft", "Approved", "Retired"]}
      }
    }
  }
}
