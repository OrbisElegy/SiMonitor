<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Monitor.Desktop/Monitor.Desktop.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
  </ItemGroup>
  <!-- The development desktop build generates the preview catalog the checks load. -->
  <Target Name="CopyStylePreviewCatalog" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../src/Monitor.Desktop/bin/$(Configuration)/net10.0/style-previews.bin"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
